<?xml version="1.0" encoding="utf-8"?>
<!-- 2×1 widget: Left to spend on the left, the last expense on the right. Text shrinks to fit, since a
     "2×1" is a different shape on a foldable's inner and outer screens. Sample text only shows in the picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="OCT · LEFT"
            android:textColor="#8F9AB5"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_left"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:text="$1,709.58"
            android:textColor="#8EA8EA"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- divider (widgets can't use a plain View, so a 1dp-wide FrameLayout) -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="34dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="#232D46" />

    <LinearLayout
        android:id="@+id/widget_last"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_last_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="🍽️ Dining"
            android:textColor="#E8ECF6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_last_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="$60.00"
            android:textColor="#E8ECF6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_last_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Today · Dinner"
            android:textColor="#8F9AB5"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
