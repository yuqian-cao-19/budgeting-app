<?xml version="1.0" encoding="utf-8"?>
<!-- 1×1 widget: the month, Left to spend, and "left". The number fits itself to its box, which the code
     makes bigger as the widget grows. Sample numbers only show in the picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:text="OCT"
        android:textColor="#8F9AB5"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_left"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:autoSizeMaxTextSize="80sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:maxLines="1"
        android:text="$1,709.58"
        android:textColor="#8EA8EA"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_left_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="left"
        android:textColor="#8F9AB5"
        android:textSize="10sp" />
</LinearLayout>
